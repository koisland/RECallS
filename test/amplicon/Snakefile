from os.path import join

FNAME_PREFIX = config.get("fname_prefix", "chm13_chr7")
OUTDIR = config.get("outdir", "test/amplicon")
LOGDIR = config.get("logdir", "test/amplicon/logs")
REF = config.get("ref", join(OUTDIR, f"{FNAME_PREFIX}.fa.gz"))


# TODO: Split by chromosome to speed up
rule get_lcr_regions:
    input:
        fa=REF,
    output:
        bed=join(OUTDIR, f"{FNAME_PREFIX}_lcr.bed"),
    log:
        join(LOGDIR, "get_lcr_regions.log"),
    shell:
        """
        longdust {input.fa} >{output.bed} 2>{log}
        """


checkpoint simulate_nahr_event:
    input:
        fa=REF,
        lcr_bed=rules.get_lcr_regions.output,
    output:
        fa=join(OUTDIR, f"{FNAME_PREFIX}_sim_after_event.fa.gz"),
        fa_outdir=join(OUTDIR, f"{FNAME_PREFIX}_sim_after_event_fa"),
        bed=join(OUTDIR, f"{FNAME_PREFIX}_sim_event.bed"),
    log:
        join(LOGDIR, "simulate_events.log"),
    threads: 24
    params:
        opts=lambda wc: "",
        events=" ".join(["inversion", "deletion"]),
        fa_uncompressed=lambda wc, output: output.fa.replace(".gz", ""),
        output_prefix=lambda wc, output: output.fa.replace("_after_event.fa.gz", ""),
        script="test/amplicon/denovo_inv_create.py",
    shell:
        """
        python {params.script} \
            -f {input.fa} \
            -n <(awk '$3-$2>500' {input.lcr_bed}) \
            -e {params.events} \
            --no_plot --all \
            -o {params.output_prefix} {params.opts} 2>{log}
        bgzip -@{threads} {params.fa_uncompressed}
        samtools faidx {output.fa}
        seqkit split -i --by-id-prefix "" -O {output.fa_outdir} {output.fa}
        """


rule simulate_nahr_event_reads:
    input:
        fa=join(rules.simulate_nahr_event.output.fa_outdir, "{fname}.fa.gz"),
    output:
        fq=join(OUTDIR, f"{FNAME_PREFIX}_sim_{{fname}}.fq.gz"),
    log:
        join(LOGDIR, "simulate_reads_{fname}.log"),
    params:
        seed=42,
        depth="1x",
        error_model="pacbio2021",
        qscore_model="pacbio2021",
        identity="30,3",
    shell:
        """
        badread simulate \
            --reference {input.fa} \
            --quantity {params.depth} \
            --error_model {params.error_model} \
            --qscore_model {params.qscore_model} \
            --identity {params.identity} \
            --start_adapter_seq "" --end_adapter_seq "" \
            --seed {params.seed} 2>{log} \
            | seqkit replace -p $ -r ' EV:Z:{wildcards.fname}' - \
            | bgzip >{output.fq}
        """


use rule simulate_nahr_event_reads as simulate_normal_reads with:
    input:
        fa=REF,
    output:
        fq=join(OUTDIR, f"{FNAME_PREFIX}_sim_norm.fq.gz"),
    log:
        join(LOGDIR, "simulate_reads_norm.log"),
    params:
        seed=9999,
        depth="5x",
        error_model="pacbio2021",
        qscore_model="pacbio2021",
        identity="30,3",


def simulated_nahr_reads(wc):
    outdir = checkpoints.simulate_nahr_event.get(**wc).output.fa_outdir
    fnames = glob_wildcards(join(outdir, "{fname}.fa.gz")).fname
    return expand(rules.simulate_nahr_event_reads.output, fname=fnames)


rule dsa_align:
    input:
        ref=REF,
        reads=lambda wc: [
            *list(rules.simulate_normal_reads.output),
            *simulated_nahr_reads(wc),
        ],
    output:
        bam=join(OUTDIR, f"{FNAME_PREFIX}_sim.bam"),
        bai=join(OUTDIR, f"{FNAME_PREFIX}_sim.bam.bai"),
    log:
        join(LOGDIR, "dsa_align.log"),
    threads: 24
    params:
        preset="lr:hq",
    shell:
        """
        {{ minimap2 --eqx -Y -ax {params.preset} {input.ref} {input.reads} -t {threads} \
            | samtools sort -u - \
            | samtools view -bh -o {output.bam} ;}} 2>{log}
        samtools index {output.bam} 2>>{log}
        """


rule all:
    default_target: True
    input:
        rules.dsa_align.output,
